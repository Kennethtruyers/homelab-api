#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

VENV="$ROOT/.venv"
PYTHON="$VENV/bin/python"
PIP="$VENV/bin/pip"

if [[ ! -f .env.local ]]; then
  echo "Create .env.local from .env.local.example and set required env vars." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1091
source .env.local
set +a

if [[ -z "${POSTGRES_CON:-}" ]]; then
  echo "POSTGRES_CON is empty in .env.local (required for full API startup)." >&2
  exit 1
fi

if [[ ! -x "$PYTHON" ]]; then
  echo "Creating .venv..."
  python3 -m venv "$VENV"
fi

if ! "$PYTHON" -c "import fastapi, uvicorn, psycopg2, yaml, requests" >/dev/null 2>&1; then
  echo "Installing dependencies from requirements.txt..."
  "$PIP" install -r requirements.txt
fi

HOST="${LOCAL_DEV_HOST:-127.0.0.1}"
PORT="${LOCAL_DEV_PORT:-8000}"

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port $PORT already in use. Stop the other process or use a different port:" >&2
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2 || true
  echo "  LOCAL_DEV_PORT=8001 ./scripts/local-dev-script" >&2
  exit 1
fi

echo "homelab-api on http://$HOST:$PORT"
echo "  ping:     curl -s http://$HOST:$PORT/ping"
if [[ -n "${IPTV_UPSTREAM_URL:-}" ]]; then
  echo "  iptv:     curl -s http://$HOST:$PORT/iptv/upstream/probe | jq"
else
  echo "  iptv:     set IPTV_UPSTREAM_URL in .env.local to enable /iptv"
fi

exec "$PYTHON" -m uvicorn main:app --reload --host "$HOST" --port "$PORT"
