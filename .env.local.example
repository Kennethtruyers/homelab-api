# Copy to .env.local and fill in (never commit .env.local)

# Required for local full API (table init on startup)
POSTGRES_CON=postgresql://homelab:password@localhost:5432/

# Optional — InfluxDB-backed routes
# INFLUX_HOST=localhost
# INFLUX_PORT=8086

# Optional — IPTV proxy (/iptv/*). Quote the URL; bash treats & as special.
# IPTV_UPSTREAM_URL='http://your-provider/get.php?username=...&password=...&type=m3u_plus'
# IPTV_FETCH_BACKEND=curl
# IPTV_READ_TIMEOUT_SECONDS=600
